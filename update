#!/usr/bin/env nix-shell
#! nix-shell -p curl jq coreutils -i bash
# shellcheck shell=bash
set -euo pipefail

ATLAS_UPDATE_SRV="${ATLAS_UPDATE_SRV:-https://atlasbinaries.com/atlas}"
ATLAS_UPDATE_SRV_FALLBACK="${ATLAS_UPDATE_SRV_FALLBACK:-https://release.ariga.io/atlas}"

# Platform mappings: nix system -> atlas binary name.
# This list is the authority for which systems the overlay supports; sources.json,
# the flake package outputs and the README are all checked against it by
# ./check-platforms. Order is significant: it fixes key order in sources.json.
PLATFORMS=(
  "x86_64-linux:linux-amd64"
  "aarch64-linux:linux-arm64"
  "x86_64-darwin:darwin-amd64"
  "aarch64-darwin:darwin-arm64"
)

# Expose the mapping so the contract checker reads it instead of re-declaring it.
# Handled before any network work so it stays a cheap, offline query.
if [[ "${1:-}" == "--print-platforms" ]]; then
  printf '%s\n' "${PLATFORMS[@]}" |
    jq -R 'split(":") | {(.[0]): .[1]}' |
    jq -s 'add'
  exit 0
fi
if [[ $# -gt 0 ]]; then
  echo "Error: unknown argument '$1' (expected none or --print-platforms)" >&2
  exit 2
fi

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

# Pick the platform string used by Atlas installers and download "latest" to discover current version.
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) PLATFORM_HOST="linux-amd64" ;;
  Linux-aarch64|Linux-arm64) PLATFORM_HOST="linux-arm64" ;;
  Darwin-x86_64|Darwin-x86-64|Darwin-amd64) PLATFORM_HOST="darwin-amd64" ;;
  Darwin-arm64|Darwin-aarch64|Darwin-armv8l) PLATFORM_HOST="darwin-arm64" ;;
  *)
    echo "Error: Unsupported host platform '$(uname -s)-$(uname -m)'"
    exit 1
    ;;
esac

echo "Discovering latest Atlas version via Atlas installer stream..."
tmp_latest_bin="$TMP_DIR/atlas-$PLATFORM_HOST-latest"
latest_downloaded=false
for server in "$ATLAS_UPDATE_SRV" "$ATLAS_UPDATE_SRV_FALLBACK"; do
  if [[ -z "$server" ]]; then
    continue
  fi
  if curl -fsSL -o "$tmp_latest_bin" "$server/atlas-$PLATFORM_HOST-latest"; then
    latest_downloaded=true
    break
  fi
done

if [[ "$latest_downloaded" != true ]]; then
  echo "Error: Failed to download atlas-$PLATFORM_HOST-latest"
  exit 1
fi
chmod +x "$tmp_latest_bin"

VERSION=$("$tmp_latest_bin" version | awk '/^atlas version / {print $3}')
if [[ -z "$VERSION" ]]; then
  echo "Error: Could not determine Atlas version"
  exit 1
fi

VERSION="${VERSION#v}"
echo "Latest version: $VERSION"

CURRENT_VERSION=$(jq -r '.version' sources.json)

# A matching version is not enough: an entry can be missing or point at the wrong
# binary, so treat an incomplete sources.json as work to do even at the same version.
stale=""
for entry in "${PLATFORMS[@]}"; do
  system="${entry%%:*}"
  binary_name="${entry#*:}"
  url=$(jq -r --arg s "$system" '.platforms[$s].url // ""' sources.json)
  sha256=$(jq -r --arg s "$system" '.platforms[$s].sha256 // ""' sources.json)
  if [[ -z "$url" || -z "$sha256" || "$url" != *"/atlas-${binary_name}-v${VERSION}" ]]; then
    stale="$stale $system"
  fi
done
stale="${stale# }"

if [[ "$CURRENT_VERSION" == "$VERSION" && -z "$stale" ]]; then
  echo "Already up to date (v$VERSION, ${#PLATFORMS[@]} platforms)"
  exit 0
fi

if [[ "$CURRENT_VERSION" == "$VERSION" ]]; then
  echo "Version v$VERSION unchanged; repairing platform entries: $stale"
else
  echo "Updating from v$CURRENT_VERSION to v$VERSION"
fi

# Fetch SHA256 hashes for each platform
for entry in "${PLATFORMS[@]}"; do
  system="${entry%%:*}"
  binary_name="${entry#*:}"

  echo "Fetching hash for $system..."

  sha256=""
  url=""
  for server in "$ATLAS_UPDATE_SRV" "$ATLAS_UPDATE_SRV_FALLBACK"; do
    if [[ -z "$server" ]]; then
      continue
    fi
    url="$server/atlas-${binary_name}-v${VERSION}"
    # Guarded so a failing mirror falls through to the fallback instead of set -e.
    if sha256=$(nix-prefetch-url "$url" 2>/dev/null) && [[ -n "$sha256" ]]; then
      break
    fi
    sha256=""
  done

  if [[ -z "$sha256" ]]; then
    echo "Error: Failed to fetch atlas-${binary_name}-v${VERSION} from any server"
    exit 1
  fi

  echo "  $system: $sha256"

  jq -n \
    --arg url "$url" \
    --arg sha256 "$sha256" \
    '{"url": $url, "sha256": $sha256}' > "$TMP_DIR/$system.json"
done

# Build new sources.json, preserving PLATFORMS order
echo "Writing sources.json..."
platforms_json="{}"
for entry in "${PLATFORMS[@]}"; do
  system="${entry%%:*}"
  platforms_json=$(jq \
    --arg system "$system" \
    --argjson source "$(cat "$TMP_DIR/$system.json")" \
    '. + {($system): $source}' <<<"$platforms_json")
done

jq -n \
  --arg version "$VERSION" \
  --argjson platforms "$platforms_json" \
  '{"version": $version, "platforms": $platforms}' > sources.json

echo "Updated to v$VERSION"
